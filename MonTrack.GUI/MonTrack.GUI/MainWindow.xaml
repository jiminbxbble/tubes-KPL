<Window x:Class="MonTrack.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MonTrack - Export GUI Demo" 
        Height="750" 
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Foreground="#333333">
    
    <Grid>
        <!-- Header -->
        <StackPanel Background="#2C3E50" VerticalAlignment="Top" Height="80">
            <TextBlock Text="MonTrack - Data Export GUI" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="White"
                       Margin="20,10,20,0"/>
            <TextBlock Text="Proof of Concept: Test data dummy export to CSV and PDF" 
                       FontSize="12" 
                       Foreground="#BDC3C7"
                       Margin="20,0,20,10"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,80,0,0">
            <StackPanel Margin="30,30,30,30">
                
                <!-- Warning Box -->
                <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1" Padding="15" CornerRadius="4" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="⚠️ CATATAN PENTING" FontWeight="Bold" Foreground="#856404" FontSize="14" Margin="0,0,0,5"/>
                        <TextBlock Text="Aplikasi ini hanya PROOF OF CONCEPT menggunakan DATA DUMMY untuk menguji fitur export. Output file TIDAK disimpan di folder penting dan hanya untuk keperluan testing." 
                                   Foreground="#856404" 
                                   TextWrapping="Wrap" 
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Input Section -->
                <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="20" CornerRadius="4" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="1. Data Configuration" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="Number of Records:" VerticalAlignment="Center" FontSize="12" Margin="0,0,0,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                <Slider x:Name="RecordCountSlider" 
                                        Width="250" 
                                        Minimum="10" 
                                        Maximum="1000" 
                                        Value="100"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="RecordCountDisplay" 
                                          Text="100" 
                                          Width="50" 
                                          FontWeight="Bold"
                                          Foreground="#27AE60"
                                          Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Export Options -->
                <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="20" CornerRadius="4" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="2. Export Options" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                        
                        <StackPanel Margin="0,0,0,0">
                            <CheckBox x:Name="CheckExportCSV" IsChecked="True" FontSize="12" Margin="0,0,0,10">
                                <TextBlock Text="Export to CSV (CsvHelper)" Foreground="#333333"/>
                            </CheckBox>
                            <CheckBox x:Name="CheckExportPDF" IsChecked="True" FontSize="12">
                                <TextBlock Text="Export to PDF (iText7)" Foreground="#333333"/>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Export Button -->
                <Button x:Name="BtnExport" 
                        Content="▶ Start Export" 
                        Height="50"
                        FontSize="14"
                        FontWeight="Bold"
                        Background="#27AE60"
                        Foreground="White"
                        Cursor="Hand"
                        Click="BtnExport_Click"
                        Margin="0,0,0,20"/>

                <!-- Status Section -->
                <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="20" CornerRadius="4" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="3. Export Results" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                        
                        <!-- CSV Status -->
                        <Border Background="#E8F5E9" Padding="15" CornerRadius="4" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="CSV Export" FontWeight="Bold" Foreground="#27AE60" Margin="0,0,0,8"/>
                                <TextBlock x:Name="CsvStatus" Text="Status: Waiting..." FontSize="11" Foreground="#333333" Margin="0,0,0,5"/>
                                <TextBlock x:Name="CsvDetails" Text="" FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- PDF Status -->
                        <Border Background="#E3F2FD" Padding="15" CornerRadius="4" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="PDF Export" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,8"/>
                                <TextBlock x:Name="PdfStatus" Text="Status: Waiting..." FontSize="11" Foreground="#333333" Margin="0,0,0,5"/>
                                <TextBlock x:Name="PdfDetails" Text="" FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Summary -->
                        <Border Background="#FFF9E6" Padding="15" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Summary" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,8"/>
                                <TextBlock x:Name="SummaryText" Text="No export performed yet." FontSize="11" Foreground="#333333"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Footer Info -->
                <TextBlock Text="Proof of Concept | Data Dummy Only | Testing Purpose Only" 
                          FontSize="10" 
                          Foreground="#999999" 
                          HorizontalAlignment="Center"
                          Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
