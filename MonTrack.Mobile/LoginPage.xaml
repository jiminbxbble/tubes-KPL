<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonTrack.Mobile.LoginPage"
             BackgroundColor="#1A1A2E"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- Background Decorations -->
        <Ellipse Fill="#4E31AA" WidthRequest="300" HeightRequest="300" HorizontalOptions="Start" VerticalOptions="Start" Margin="-100,-100,0,0" Opacity="0.3"/>
        
        <VerticalStackLayout VerticalOptions="Center" Padding="30" Spacing="20">
            
            <!-- Logo & Title -->
            <Image Source="dotnet_bot.png" HeightRequest="100" Margin="0,0,0,10"/>
            <Label Text="MonTrack" TextColor="White" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="5"/>
            <Label Text="Your Premium Finance Companion" TextColor="#BDC3C7" FontSize="12" HorizontalOptions="Center" Margin="0,-10,0,30"/>

            <!-- Login Form (Glass Card) -->
            <Frame BackgroundColor="#22FFFFFF" BorderColor="#44FFFFFF" CornerRadius="20" Padding="25">
                <VerticalStackLayout Spacing="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Email Address" TextColor="#BDC3C7" FontSize="12"/>
                        <Entry x:Name="EmailEntry" Placeholder="name@email.com" TextColor="White" PlaceholderColor="#66FFFFFF" Keyboard="Email"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Password" TextColor="#BDC3C7" FontSize="12"/>
                        <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="••••••••" TextColor="White" PlaceholderColor="#66FFFFFF"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ConfirmPasswordStack" Spacing="5" IsVisible="False">
                        <Label Text="Confirm Password" TextColor="#BDC3C7" FontSize="12"/>
                        <Entry x:Name="ConfirmPasswordEntry" IsPassword="True" Placeholder="••••••••" TextColor="White" PlaceholderColor="#66FFFFFF"/>
                    </VerticalStackLayout>

                    <Button x:Name="BtnLogin" Text="Login Now" BackgroundColor="#4E31AA" TextColor="White" HeightRequest="50" CornerRadius="12" Margin="0,15,0,0" Clicked="BtnLogin_Clicked"/>
                </VerticalStackLayout>
            </Frame>

            <Label x:Name="StatusLabel" Text="" TextColor="#FF7675" FontSize="12" HorizontalOptions="Center"/>

            <!-- Footer -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,20,0,0">
                <Label x:Name="FooterTextLabel" Text="Don't have an account?" TextColor="#BDC3C7" FontSize="12"/>
                <Label x:Name="FooterActionLabel" Text="Sign Up" TextColor="#3795BD" FontSize="12" FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ToggleMode_Tapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
